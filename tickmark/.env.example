TICKMARK_WARDEN_URL=http://localhost:5000
# Azure Document Intelligence (portal: your Document Intelligence resource -> Keys and Endpoint)
TICKMARK_DOCINT_ENDPOINT=
TICKMARK_DOCINT_KEY=
TICKMARK_DOCINT_MODEL=prebuilt-invoice
TICKMARK_DATABASE_URL=postgresql+psycopg://tickmark_app:tickmark_app@localhost:5435/tickmark
TICKMARK_ADMIN_DATABASE_URL=postgresql+psycopg://tickmark:tickmark@localhost:5435/tickmark
TICKMARK_EVIDENCE_DIR=data/store
# The header row is looked for in this many non-blank rows at the top of a sheet (title blocks above it)
TICKMARK_HEADER_SCAN_ROWS=20
# LLM column mapping (off by default). VALUES sends real example values: a separate decision.
TICKMARK_LLM_MAPPING=off
TICKMARK_LLM_MAPPING_VALUES=off
# Any OpenAI-compatible chat completions API; OpenRouter shown. The model must support structured
# outputs (json_schema), e.g. an anthropic/claude-* or openai/gpt-* model id from openrouter.ai/models.
TICKMARK_LLM_BASE_URL=https://openrouter.ai/api/v1
TICKMARK_LLM_API_KEY=
TICKMARK_LLM_MAPPING_MODEL=

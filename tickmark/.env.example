TICKMARK_WARDEN_URL=http://localhost:5000
# The agent (python -m tickmark.agent) and its tools (/tools/*), behind Warden:
TICKMARK_AGENT_ID=a9e00000-0000-0000-0000-000000000001
TICKMARK_TOOLS_AUDIENCE=tickmark-tools
TICKMARK_ENGAGEMENTS_DIR=data/engagements
# Azure Document Intelligence (portal: your Document Intelligence resource -> Keys and Endpoint)
TICKMARK_DOCINT_ENDPOINT=
TICKMARK_DOCINT_KEY=
TICKMARK_DOCINT_MODEL=prebuilt-invoice
TICKMARK_DATABASE_URL=postgresql+psycopg://tickmark_app:tickmark_app@localhost:5435/tickmark
TICKMARK_ADMIN_DATABASE_URL=postgresql+psycopg://tickmark:tickmark@localhost:5435/tickmark
TICKMARK_EVIDENCE_DIR=data/store
# The header row is looked for in this many non-blank rows at the top of a sheet (title blocks above it)
TICKMARK_HEADER_SCAN_ROWS=20
# PDFs are read from their own text first. Azure: auto = only where that is not reliable (scans,
# broken or rotated text, a value not found clearly); off = never (those rows stay 👀/❓ with why);
# always = every PDF. Thresholds for "cannot be read from its own text" (tune with tools.compare_readers):
TICKMARK_AZURE=auto
# allowed VAT rates in % when the engagement sets none (engagements and runs can set their own)
TICKMARK_VAT_RATES=0,9,21
# below this Azure confidence a value counts only if the invoice confirms it (net+tax=total, printed text)
TICKMARK_CONFIDENCE_MIN=0.90
TICKMARK_READ_CONCURRENCY=8
TICKMARK_PDF_MIN_CHARS=30
TICKMARK_PDF_IMAGE_COVER=0.7
TICKMARK_PDF_BAD_CHARS=0.02
TICKMARK_PDF_ROTATED=0.2
TICKMARK_PDF_WORD_GAP=15
TICKMARK_PDF_LETTERHEAD_SHARE=0.33
# LLM column mapping (off by default). VALUES sends real example values: a separate decision.
TICKMARK_LLM_MAPPING=off
TICKMARK_LLM_MAPPING_VALUES=off
# Any OpenAI-compatible chat completions API; OpenRouter shown. The model must support structured
# outputs (json_schema), e.g. an anthropic/claude-* or openai/gpt-* model id from openrouter.ai/models.
TICKMARK_LLM_BASE_URL=https://openrouter.ai/api/v1
TICKMARK_LLM_API_KEY=
TICKMARK_LLM_MAPPING_MODEL=
# Step-by-step logs (console + data/logs/tickmark.log; they contain client values: local use).
# INFO: each step's decision; DEBUG: every candidate and comparison too. The web app shows both.
TICKMARK_LOG_LEVEL=INFO
TICKMARK_LOG_DIR=data/logs
TICKMARK_UPLOAD_DIR=data/uploads
